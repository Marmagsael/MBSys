@model MBApps.Models.Authentication.LoginUiModel
@{
    Layout = null;
    string coName    = ViewData["CoName"]?.ToString()    ?? "MBApps";
    string exclusive = ViewData["Exclusive"]?.ToString() ?? "false";
    string errorMsg  = ViewData["ErrorMsg"]?.ToString()  ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — @coName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <style>
        body {
            background: #f0f2f5;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 100%;
            max-width: 400px;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,.10);
        }
        .login-header {
            background: #1a1a2e;
            color: #fff;
            border-radius: 12px 12px 0 0;
            padding: 2rem;
            text-align: center;
        }
        .login-body {
            padding: 2rem;
            background: #fff;
            border-radius: 0 0 12px 12px;
        }
    </style>
</head>
<body>

<div class="login-card">
    <div class="login-header">
        <i class="fa fa-cubes fa-2x mb-2"></i>
        <h5 class="mb-0">@coName</h5>
        <small class="text-white-50">Please sign in to continue</small>
    </div>
    <div class="login-body">

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="alert alert-danger py-2">
                <i class="fa fa-exclamation-circle me-1"></i> @errorMsg
            </div>
        }

        <form method="post" action="/login">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Username</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-user"></i></span>
                    <input type="text"
                           name="LoginName"
                           class="form-control"
                           placeholder="Enter username"
                           value="@Model?.LoginName"
                           required autofocus />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-lock"></i></span>
                    <input type="password"
                           name="Password"
                           class="form-control"
                           placeholder="Enter password"
                           required />
                </div>
            </div>

            <button type="submit" class="btn btn-dark w-100">
                <i class="fa fa-sign-in-alt me-1"></i> Sign In
            </button>
        </form>

    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
